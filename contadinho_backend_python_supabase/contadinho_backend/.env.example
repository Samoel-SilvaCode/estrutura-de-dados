# Copie este arquivo para .env e preencha os valores do seu projeto Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_SUA_CHAVE_SECRETA_AQUI

# Origin do GitHub Pages (somente protocolo + domínio; sem caminho /repositorio)
# Para testar localmente, mantenha também os endereços localhost.
FRONTEND_ORIGINS=https://SEU_USUARIO.github.io,http://127.0.0.1:5500,http://localhost:5500
